KIT_API_BASE=https://ht.knowvally.com
KIT_PARTICIPANT_KEY=
# Required: speech-to-text + AI
GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Optional extra AI / speech providers (added to the failover chain)
# GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
# Encrypts stored login sessions so users stay logged in across restarts (any long random string)
SESSION_SECRET=
# History: Postgres when set, otherwise SQLite at data/history.db
DATABASE_URL=
# DATABASE_SSL=true   # only for external Postgres URLs that require SSL
PORT=3000
